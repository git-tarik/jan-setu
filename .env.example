# ─────────────────────────────────────────────────────────────────
# Jan Setu - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────

# GEMINI_API_KEY: Your Google Gemini API key.
# Get one at: https://aistudio.google.com/apikey
# Required for AI-powered NLU features. The app still works without
# it — it falls back to the built-in rule-based entity extractor.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this app is hosted (used for self-referential links).
# For local development, leave as default:
APP_URL=http://localhost:3000
